# SPEC-004
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/k1_studio /app/src/k1_studio
ENV PYTHONPATH=/app/src K1_WORKSPACE=/workspace
RUN useradd --create-home studio && mkdir /workspace && chown studio /workspace
USER studio
EXPOSE 8000
CMD ["uvicorn", "k1_studio.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
